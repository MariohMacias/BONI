# BONI - Configuración de entorno
# Copia este archivo como .env y ajusta los valores

# IP de WSL2 (cambia según tu red)
WSL_IP=192.168.1.100

# Gateway de Windows
WIN_GW=

# OpenJarvis API (opcional)
JARVIS_API=http://localhost:8080/v1
JARVIS_KEY=tu-key-local

# Ollama
OLLAMA_URL=http://localhost:11434

# Rendimiento (opcional)
BONI_MODEL=tinyllama:1.1b          # Modelo normal (rápido por defecto)
BONI_TURBO_MODEL=tinyllama:1.1b    # Modelo turbo (aún más rápido)
BONI_NUM_CTX=2048                  # Contexto (menor = más rápido)
BONI_NUM_PREDICT=512               # Tokens máx por respuesta
